{
  "default_locale": "en",
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.6.85",
  "description": "__MSG_extDescription__",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "optional_permissions": [
    "clipboardRead"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "OLED Night",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "options_page": "options.html",
  "commands": {
    "toggle-extension": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "__MSG_cmdToggleExtension__"
    },
    "toggle-site": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "__MSG_cmdToggleSite__"
    },
    "toggle-extension-backup": {
      "suggested_key": {
        "default": "Ctrl+Shift+9"
      },
      "description": "__MSG_cmdToggleExtensionBackup__"
    },
    "toggle-site-backup": {
      "suggested_key": {
        "default": "Ctrl+Shift+8"
      },
      "description": "__MSG_cmdToggleSiteBackup__"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "exclude_matches": [
        "*://challenges.cloudflare.com/*",
        "*://*.hcaptcha.com/*",
        "*://www.google.com/recaptcha/*",
        "*://www.recaptcha.net/*",
        "*://*.arkoselabs.com/*",
        "*://*.funcaptcha.com/*",
        "*://*.captcha-delivery.com/*",
        "*://*.perimeterx.net/*",
        "*://*.px-cloud.net/*",
        "*://*.geetest.com/*",
        "*://*.friendlycaptcha.com/*",
        "*://*.awswaf.com/*",
        "*://*.mtcaptcha.com/*"
      ],
      "js": [
        "settings.js",
        "color-utils.js",
        "youtube-theme.js",
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
